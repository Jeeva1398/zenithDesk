PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zenithdesk

WAREHOUSE_DB_NAME=zenithdesk_warehouse

# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
CUSTOMER_JWT_EXPIRES_IN=20m

# Comma-separated list of browser origins allowed to call this API.
# Optional in development (defaults to localhost:5173-5175); required in production.
CORS_ORIGINS=

# Number of reverse proxies in front of this server. Leave at 0 when there is
# no proxy â setting it too high lets callers spoof their IP past rate limits.
TRUST_PROXY_HOPS=0

# Comma-separated IPs of trusted internal services (e.g. the chatbot server).
# Only these hosts may set X-ZenithDesk-Client-IP to declare the end user they
# are acting for, which the OTP rate limiters key on instead of the caller IP.
TRUSTED_SERVICE_IPS=

# Cron expression for the warehouse ETL, e.g. 0 * * * * for hourly. Leave it
# empty to disable the schedule; the job then runs only when you invoke it by
# hand. Two runs must never overlap, so a tick is skipped if one is still going.
ETL_SCHEDULE=
ETL_SCHEDULE_TZ=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Where ticket attachments (files customers send through the chat widget) are
# stored on disk. Defaults to server/uploads. Must be persistent storage.
UPLOAD_DIR=
