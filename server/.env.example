PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zenithdesk

WAREHOUSE_DB_NAME=zenithdesk_warehouse

# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
CUSTOMER_JWT_EXPIRES_IN=20m

# Comma-separated list of browser origins allowed to call this API.
# Optional in development (defaults to localhost:5173-5175); required in production.
CORS_ORIGINS=

# Number of reverse proxies in front of this server. Leave at 0 when there is
# no proxy — setting it too high lets callers spoof their IP past rate limits.
TRUST_PROXY_HOPS=0

RESEND_API_KEY=
RESEND_FROM_EMAIL=
